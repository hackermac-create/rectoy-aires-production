# Copiez ce fichier en ".env" pour le développement local (jamais sur GitHub).
# Sur Render, ces valeurs se saisissent dans l'onglet Environment.

PORT=4000
NODE_ENV=development

# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=remplacez_par_une_chaine_aleatoire_longue

ADMIN_USERNAME=admin
# node hash-password.js "VotreMotDePasseSolide"
ADMIN_PASSWORD_HASH=collez_ici_le_hash_genere_par_hash-password.js

ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5500

# Base locale (PostgreSQL)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=rectoy_aires
DB_USER=rectoy_admin
DB_PASSWORD=votre_mot_de_passe_postgres

# En production, utilisez UNIQUEMENT ceci à la place des DB_* :
# DATABASE_URL=postgresql://utilisateur:motdepasse@hote:5432/nom_base
# DATABASE_SSL=true

# --- Assistant IA (facultatif) -------------------------------------------
# Sans clé, l'assistant répond avec la base src/assistant/knowledge.js (gratuit).
# Avec une clé Anthropic, un modèle Claude répond en s'appuyant sur cette même base.
# ANTHROPIC_API_KEY=sk-ant-...
# ASSISTANT_MODEL=claude-sonnet-5-5
# Coordonnées du conseiller (par défaut : celles du site)
# ADVISOR_WHATSAPP=2250705801517
# ADVISOR_EMAIL=rectoyaires@gmail.com
# ADVISOR_PHONE=+225 0705801517

# --- Réseaux sociaux (facultatif) : voir GUIDE-RESEAUX-SOCIAUX.md --------
# SITE_URL=https://www.votre-domaine.com
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_TOKEN=
# INSTAGRAM_ACCOUNT_ID=

# Poids maximum d'une vidéo envoyée depuis l'admin (en Mo). Au-delà : utiliser un lien YouTube / Vimeo.
VIDEO_MAX_MB=40
